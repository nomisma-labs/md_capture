{
    "log": {
        "level": "info",
        "file": {
            "name": "log/okx_md_capture.log"
        }
    },
    "app_control": {
        "exit_after_sec": null,
        "health_check_period_msec": 2000
    },
    "md_subscriber": {
        "connection": {
            "endpoint": "wss://ws.okx.com/ws/v5/public",
            "heartbeat_sec": 20
        },
        "subscription": {
            "symbols": [
                "BTC-USDT"
            ],
            "channels": [
                "tickers",
                "trades",
                "books"
            ]
        }
    },
    "md_sink": {
        "md_logger": {
            "file": "data/okx_spot.dat"
        }
    }
}